# ==============================================================================
# WINTERWEAR E-COMMERCE ENGINE — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

MONGO_URI=mongodb://127.0.0.1:27017/winterwear
ADMIN_NAME=WinterWear Admin
ADMIN_EMAIL=admin@winterwear.com
ADMIN_PASSWORD=Admin@123


# JWT Authentication & Session Security
# Ensure production secrets are minimum 32 random characters
JWT_ACCESS_SECRET=winterwear_super_secure_jwt_access_secret_key_minimum_32_chars_2026
JWT_REFRESH_SECRET=winterwear_super_secure_jwt_refresh_secret_key_minimum_32_chars_2026
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
PASSWORD_RESET_EXPIRES=3600000

# Cloudinary Media Storage (Products, Videos, Campaign Lookbooks)
CLOUDINARY_CLOUD_NAME=dfk6vwfgv
CLOUDINARY_API_KEY=554342919676352
CLOUDINARY_API_SECRET=BTOIlouAWibNV3afto_ssgi2bAI

# Payment Gateways & Routing
PAYMENT_PROVIDER=stripe
ENABLE_CASH_ON_DELIVERY=true
PAYMENT_SUCCESS_URL=http://localhost:5173/checkout/success
PAYMENT_CANCEL_URL=http://localhost:5173/checkout/cancelled

# Stripe Configuration (Primary Gateway)
# For Pakistan: Requires Stripe Atlas or international entity account
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MODE=sandbox

# Safepay Configuration (Pakistan Domestic Alternative)
# Activate by setting PAYMENT_PROVIDER=safepay
SAFEPAY_API_KEY=sec_...
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=whsec_...
SAFEPAY_ENVIRONMENT=sandbox

# Currency & Shipping Policies (PKR)
DEFAULT_CURRENCY=PKR
FREE_SHIPPING_THRESHOLD_PKR=5000
FLAT_SHIPPING_FEE_PKR=250

# Inventory & Stock Reservation Expiry
RESERVATION_EXPIRY_MINUTES=30

# Transactional Email (SMTP / Nodemailer)
# In development, leave blank to automatically use Ethereal test mailbox
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@mg.winterwear.pk
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=WinterWear Atelier <concierge@winterwear.fashion>

# Phase 7: Grounded AI Concierge & Business Intelligence
# Supported providers: 'deterministic' (zero API key needed) | 'openai' | 'anthropic' | 'gemini'
# If API keys are omitted, the system operates seamlessly in deterministic fallback mode
AI_PROVIDER=deterministic
AI_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.2
AI_TIMEOUT_MS=8000

