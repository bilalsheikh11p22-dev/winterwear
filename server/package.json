    "db:indexes": "node scripts/syncNotificationIndexes.js"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "ecommerce",
    "fashion",
    "winterwear",
    "luxury",
    "express",
    "mongodb",
    "mongoose",
    "rbac"
