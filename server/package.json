{
  "name": "winterwear-server",
  "version": "1.0.0",
  "description": "WinterWear Full-Stack Premium Fashion E-Commerce Backend",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seed/seedData.js",
