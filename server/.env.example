# ==============================================================================
# WINTERWEAR E-COMMERCE ENGINE — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://winterwear_admin:YourSecurePassword123@cluster0.abcde.mongodb.net/winterwear?retryWrites=true&w=majority

# JWT Authentication & Session Security
# Ensure production secrets are minimum 32 random characters
JWT_ACCESS_SECRET=winterwear_super_secure_jwt_access_secret_key_minimum_32_chars_2026
JWT_REFRESH_SECRET=winterwear_super_secure_jwt_refresh_secret_key_minimum_32_chars_2026
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
PASSWORD_RESET_EXPIRES=3600000

# Cloudinary Media Storage (Products, Videos, Campaign Lookbooks)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Payment Gateways & Routing
PAYMENT_PROVIDER=stripe
ENABLE_CASH_ON_DELIVERY=true
PAYMENT_SUCCESS_URL=http://localhost:5173/checkout/success
PAYMENT_CANCEL_URL=http://localhost:5173/checkout/cancelled

# Stripe Configuration (Primary Gateway)
# For Pakistan: Requires Stripe Atlas or international entity account
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MODE=sandbox

# Safepay Configuration (Pakistan Domestic Alternative)
# Activate by setting PAYMENT_PROVIDER=safepay
SAFEPAY_API_KEY=sec_...
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=whsec_...
SAFEPAY_ENVIRONMENT=sandbox

# Currency & Shipping Policies (PKR)
DEFAULT_CURRENCY=PKR
FREE_SHIPPING_THRESHOLD_PKR=5000
FLAT_SHIPPING_FEE_PKR=250

# Inventory & Stock Reservation Expiry
RESERVATION_EXPIRY_MINUTES=30

# Transactional Email (SMTP / Nodemailer)
# In development, leave blank to automatically use Ethereal test mailbox
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@mg.winterwear.pk
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=WinterWear Atelier <concierge@winterwear.fashion>

# Phase 7: Grounded AI Concierge & Business Intelligence
# Supported providers: 'deterministic' (zero API key needed) | 'openai' | 'anthropic' | 'gemini'
# If API keys are omitted, the system operates seamlessly in deterministic fallback mode
AI_PROVIDER=deterministic
AI_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.2
AI_TIMEOUT_MS=8000


# ==============================================================================
# NOTIFICATIONS, REAL-TIME, EMAIL & BACKGROUND JOBS
# ==============================================================================

# Socket.IO — extra allowed browser origins (comma-separated). CLIENT_URL is always allowed.
SOCKET_CORS_ORIGIN=http://localhost:5173

# Public base URL of THIS API. Used to build the one-click unsubscribe link inside promotional emails.
API_PUBLIC_URL=http://localhost:5000

# Email: SMTP_HOST / SMTP_PORT / SMTP_SECURE / SMTP_USER / SMTP_PASSWORD / EMAIL_FROM (above) drive it.
# If these are blank or still placeholders, in-app notifications keep working and emails are
# recorded as "skipped: email_not_configured" (visible in Admin → Notifications).

# Background worker (outbox retries, scheduled campaigns, reminders, reconciliation)
WORKER_ENABLED=true        # false on API instances when you run `npm run worker` separately
WORKER_INTERVAL_MS=5000
OUTBOX_INLINE=true         # also process events ~25ms after they are queued (lower latency); the worker is the safety net

# Marketing guard-rails
MARKETING_MAX_PER_DAY=3    # max promotional in-app notifications per customer per 24h
CAMPAIGN_BATCH_SIZE=200    # recipients processed per campaign batch
FULFILLMENT_SLA_HOURS=24   # confirmed/processing orders older than this alert fulfilment staff

# OPTIONAL — only needed when running MORE THAN ONE API instance (Socket.IO needs a shared adapter).
# Also run:  npm install @socket.io/redis-adapter redis      (not installed by default; not covered by the test suite)
# REDIS_URL=redis://localhost:6379

# Tests (never point this at a real database — tests refuse anything but a local *_test_* database)
# TEST_MONGODB_BASE=mongodb://127.0.0.1:27017
