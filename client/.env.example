# ==============================================================================
# WINTERWEAR STOREFRONT — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Primary Backend API Endpoint
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Cloudinary Public Assets Delivery (Cloud Name only — NEVER expose API Secret)
VITE_CLOUDINARY_CLOUD_NAME=winterwear-archive

# Stripe Public Key (For client-side card element mounts if used)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51...

# Currency & Order Valuation (Pakistan Domestic Store)
VITE_CURRENCY=PKR
VITE_FREE_SHIPPING_THRESHOLD=5000
VITE_FLAT_SHIPPING_FEE=250

# Feature Toggles
VITE_ENABLE_COD=true
